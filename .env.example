# ============================================================
# Wintermute Transaction Monitor — Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here,another_chat_id  # Comma separated list of chat IDs

# --- Thresholds ---
USD_THRESHOLD=100000
POLL_INTERVAL=180

# --- Accumulation Tracking ---
ACCUMULATION_ENABLED=true
ACCUMULATION_USD_THRESHOLD=500000
ACCUMULATION_WINDOW_HOURS=24
ACCUMULATION_MIN_TX_COUNT=2

# --- Explorer API Keys (free tier is fine) ---
# Etherscan accounts now unify API keys across all EVM explorers (Arbiscan, BscScan, etc).
ETHERSCAN_API_KEY=your_etherscan_api_key

# --- CoinGecko (optional) ---
COINGECKO_API_KEY=
